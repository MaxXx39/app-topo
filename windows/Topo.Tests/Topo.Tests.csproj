<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests des calculs de l'appli Windows (sans fenêtre) : lancés par GitHub avant de fabriquer Topo.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Topo.Tests</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Security" />
    <!-- Les fichiers de calcul de l'appli (tout sauf la fenêtre, qui a besoin de WebView2 et de Windows). -->
    <Compile Include="..\Topo\Json.cs" />
    <Compile Include="..\Topo\Nmea.cs" />
    <Compile Include="..\Topo\Mn95.cs" />
    <Compile Include="..\Topo\Ntrip.cs" />
    <Compile Include="..\Topo\ClientNtrip.cs" />
    <Compile Include="..\Topo\EtatRecepteur.cs" />
    <Compile Include="..\Topo\RecepteurSerie.cs" />
    <Compile Include="..\Topo\Reglages.cs" />
    <Compile Include="..\Topo\Drive.cs" />
    <Compile Include="..\Topo\ServeurAppli.cs" />
    <Compile Include="..\Topo\MiseAJour.cs" />
  </ItemGroup>
</Project>
