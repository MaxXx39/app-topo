<Project Sdk="Microsoft.NET.Sdk">
  <!-- Petit programme de test Windows (CC180) : lit un récepteur GNSS sur un port COM (Bluetooth ou USB).
       .NET Framework 4.8 est déjà dans Windows 10 21H2 : rien à installer, aucune bibliothèque en plus. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Topo-Test-Recepteur</AssemblyName>
    <RootNamespace>TestRecepteur</RootNamespace>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
