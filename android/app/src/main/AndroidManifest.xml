<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet : fonds de carte swisstopo (photo aérienne, cadastre) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bluetooth (flux NMEA du récepteur Emlid) : anciennes versions d'Android -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Bluetooth : Android 12 et plus récent (« Appareils à proximité ») -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Petite vibration quand un point est pris -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:icon="@mipmap/ic_lanceur"
        android:label="@string/nom_appli"
        android:theme="@style/Theme.Topo">

        <!-- configChanges : la page n'est pas rechargée quand on tourne le téléphone. -->
        <activity
            android:name=".EcranPrincipal"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
